{
  "name": "backoffice-site",
  "version": "1.36.0",
  "config": {
    "container": {
      "registry": "registry.gitlab.com/rayprosoft/turnkey-gaming-system"
    }
  },
  "type": "module",
  "scripts": {
    "start": "cross-env-shell SNOWPACK_PUBLIC_BUILD_DATE=$(date +%F_%T) snowpack dev --reload",
    "build": "cross-env-shell SNOWPACK_PUBLIC_BUILD_DATE=$(date +%F_%T) snowpack build",
    "build:docker": "cross-var docker build . -t $npm_package_config_container_registry/$npm_package_name:$npm_package_version",
    "push:docker": "cross-var docker push $npm_package_config_container_registry/$npm_package_name:$npm_package_version",
    "deploy:k8s": "kubectl set image deployment/$npm_package_name $npm_package_name=$npm_package_config_container_registry/$npm_package_name:$npm_package_version --record -n=$ENV",
    "test": "playwright test --workers=2",
    "debug:test": "playwright test --headed --debug",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "lint": "prettier --check \"src/**/*.{js,jsx}\"",
    "tag:docker:dev": "cross-env-shell GIT_COMMIT_HASH=$(git show --no-patch --format=%h) \"npm-run-all build:docker:dev push:docker:dev\"",
    "build:docker:dev": "cross-var docker build . -t $npm_package_config_container_registry/$npm_package_name:$npm_package_version-$GIT_COMMIT_HASH",
    "push:docker:dev": "docker push $npm_package_config_container_registry/$npm_package_name:$npm_package_version-$GIT_COMMIT_HASH",
    "prepare": "husky install"
  },
  "dependencies": {
    "chai": "4.3.4",
    "form-data": "^4.0.0",
    "fs-extra": "^10.0.0",
    "got": "^11.8.2",
    "nanoid": "^3.1.30",
    "ramda": "^0.27.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
    "@ariakit/react": "0.2.9",
    "@babel/preset-env": "7.22.5",
    "@babel/preset-react": "7.22.5",
    "@dnd-kit/core": "^6.0.7",
    "@dnd-kit/sortable": "^7.0.2",
    "@dnd-kit/utilities": "^3.2.1",
    "@emotion/babel-preset-css-prop": "^11.10.0",
    "@emotion/react": "^11.10.5",
    "@faker-js/faker": "5.5.3",
    "@fortawesome/free-regular-svg-icons": "^5.15.4",
    "@fortawesome/free-solid-svg-icons": "^5.15.4",
    "@microsoft/signalr": "^7.0.0",
    "@monaco-editor/react": "^4.4.6",
    "@opentelemetry/context-zone": "1.14.0",
    "@opentelemetry/instrumentation": "0.40.0",
    "@opentelemetry/instrumentation-fetch": "0.40.0",
    "@opentelemetry/sdk-trace-web": "1.14.0",
    "@playwright/test": "1.34.3",
    "@react-spring/web": "^9.5.5",
    "@snowpack/plugin-babel": "^2.1.7",
    "@snowpack/plugin-dotenv": "^2.1.0",
    "@snowpack/plugin-react-refresh": "^2.5.0",
    "@tanstack/react-table": "^8.7.4",
    "@vvo/tzdb": "^6.89.0",
    "animejs": "^3.2.1",
    "big.js": "^6.1.1",
    "boolean": "^3.1.4",
    "bumbag": "2.7.21",
    "camelcase": "^6.2.0",
    "camelcase-keys": "^6.2.2",
    "clipboard-copy": "^4.0.1",
    "clone-deep": "^4.0.1",
    "cross-env": "^7.0.3",
    "cross-var": "^1.1.0",
    "date-fns": "2.28.0",
    "date-fns-tz": "1.3.7",
    "dotenv": "^9.0.2",
    "dotenv-cli": "^4.0.0",
    "fast-deep-equal": "^3.1.3",
    "fast-memoize": "^2.5.2",
    "http-proxy": "^1.18.1",
    "husky": "^7.0.0",
    "json-stringify-pretty-compact": "^3.0.0",
    "lodash-es": "^4.17.21",
    "match-sorter": "^6.3.1",
    "monaco-editor": "^0.34.1",
    "npm-run-all": "^4.1.5",
    "numeral": "^2.0.6",
    "playwright": "1.34.3",
    "prettier": "^2.7.1",
    "react-datepicker": "3.8.0",
    "react-dropzone": "^11.4.2",
    "react-hook-form": "7.41.5",
    "react-infinite-scroll-component": "^6.1.0",
    "react-intersection-observer": "^9.3.5",
    "react-router-dom": "^6.10.0",
    "react-select": "^5.7.3",
    "react-select-async-paginate": "^0.7.2",
    "react-table": "7.6.3",
    "react-use": "^17.4.0",
    "react-virtualized-auto-sizer": "1.0.20",
    "react-window": "^1.8.9",
    "reakit": "^1.3.11",
    "snowpack": "3.0.13",
    "super-expressive": "^1.4.0",
    "swr": "^0.5.6",
    "tinymce": "5.5.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.18.12/xlsx-0.18.12.tgz",
    "xml-formatter": "^2.4.0"
  }
}
